{
  "name": "louvorja",
  "version": "1.28.25",
  "description": "LouvorJA - Software de Louvor Adventista, projeção de letras, músicas e vídeos para facilitar a experiência de louvor em sua igreja.",
  "author": {
    "name": "Mayco Rolbuche",
    "email": "mayco_rolbuche@hotmail.com"
  },
  "homepage": "https://louvorja.com.br/",
  "repository": "https://github.com/tiagoadv7/louvorja",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "version:major": "npm version major",
    "version:minor": "npm version minor",
    "version:patch": "npm version patch",
    "version:max": "npm version major",
    "version:min": "npm version minor",
    "version:bug": "npm version patch",
    "serve": "vite preview",
    "build": "vite build",
    "lint": "eslint .",
    "dev": "vite",
    "host": "vite --host",
    "files": "node node/server.js",
    "git:tag": "git tag -a -f v%npm_package_version% -m \"Versão %npm_package_version%\" && git push origin -f v%npm_package_version% && git push -u origin main",
    "electron:dev": "concurrently -n VITE,ELECTRON -c yellow,blue \"cross-env VITE_DISABLE_PWA=true vite --port 5002 --strictPort\" \"wait-on http://localhost:5002 && node electron/dev.js\"",
    "electron:build": "node scripts/prepare-bundle.js --bundle-only && cross-env ELECTRON_BUILD=true vite build && electron-builder",
    "electron:build:linux": "node scripts/prepare-bundle.js --bundle-only && cross-env ELECTRON_BUILD=true vite build && electron-builder --linux",
    "electron:build:linux:wsl": "powershell -ExecutionPolicy Bypass -File scripts/build-linux-wsl.ps1",
    "electron:publish": "node scripts/prepare-bundle.js --bundle-only && cross-env ELECTRON_BUILD=true vite build && node scripts/publish.js",
    "electron:preview": "cross-env ELECTRON_BUILD=true vite build && node electron/dev.js",
    "electron:pack": "cross-env ELECTRON_BUILD=true vite build && electron-builder --dir",
    "electron:rebuild": "echo better-sqlite3 nao necessario — usando sql.js",
    "bundle:prepare": "node scripts/prepare-bundle.js",
    "bundle:dev-only": "node scripts/prepare-bundle.js --dev-only",
    "bundle:build-only": "node scripts/prepare-bundle.js --bundle-only"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "archiver": "^7.0.1",
    "basic-ftp": "^5.0.5",
    "core-js": "^3.40.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.2.0",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "roboto-fontface": "*",
    "sql.js": "^1.14.1",
    "vue": "^3.5.29",
    "vue-country-flag-next": "^2.3.2",
    "vue-fullscreen": "^3.1.3",
    "vue-i18n": "^11.2.8",
    "vue-json-pretty": "^2.4.0",
    "vue-router": "^5.0.3",
    "vue3-shortkey": "^4.0.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.0.0",
    "vuex": "^4.0.2",
    "webfontloader": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.3",
    "eslint-plugin-vue": "^9.33.0",
    "playwright-core": "^1.60.0",
    "sass": "^1.83.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vuetify": "^2.1.3",
    "wait-on": "^9.0.10"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "rules": {}
  },
  "build": {
    "appId": "louvorja.com.br",
    "productName": "Louvor JA",
    "copyright": "Copyright © 2026 Louvor JA",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/ico/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Louvor JA",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/ico/favicon.ico",
      "category": "AudioVideo"
    },
    "asarUnpack": [
      "node_modules/sql.js/**/*",
      "node_modules/qrcode/**/*"
    ],
    "extraFiles": [
      {
        "from": "bundled/config",
        "to": "config",
        "filter": [
          "database.db",
          "capas/**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
