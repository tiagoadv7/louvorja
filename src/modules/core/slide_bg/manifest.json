{
  "id": "slide_bg",
  "name": "Fundo Personalizado",
  "description": "Personaliza o fundo, texto e janela dos slides de músicas e apresentações.",
  "category": null,
  "showInMainMenu": true,
  "icon": "mdi-image-multiple-outline",
  "dependencies": [],
  "moduleOptions": {
    "width": 570,
    "height": 900
  },
  "customization": {
    "bg_type":        { "default": "none" },
    "background_color": {
      "type": "color",
      "label": "customization.color",
      "default": ""
    },
    "image": {
      "type": "image",
      "label": "customization.image",
      "default": ""
    },
    "image_opacity": {
      "type": "opacity",
      "label": "customization.transparency",
      "default": 85
    },
    "image_fit": {
      "type": "object-fit",
      "label": "customization.adjust",
      "default": "cover"
    },
    "animated_bg": {
      "type": "animated-bg",
      "label": "customization.animated_bg",
      "default": "none"
    },
    "animated_bg_color": {
      "type": "color",
      "label": "customization.animated_bg_color",
      "default": "#7aa0ff"
    },
    "horizontal_align": {
      "type": "h-align",
      "label": "customization.horizontal",
      "default": "center"
    },
    "vertical_align": {
      "type": "v-align",
      "label": "customization.vertical",
      "default": "center"
    },
    "video": { "default": "" },
    "font": {
      "type": "font",
      "label": "customization.font",
      "default": "DINCondensedBold, sans-serif"
    },
    "font_size": {
      "type": "font-size",
      "label": "customization.size",
      "default": 20
    },
    "font_color": {
      "type": "color",
      "label": "customization.font_color",
      "default": "#FFFFFF"
    },
    "cover_font_size": {
      "type": "font-size",
      "label": "customization.cover_font_size",
      "default": 25
    },
    "cover_font_color": {
      "type": "color",
      "label": "customization.cover_font_color",
      "default": "#F6C32A"
    },
    "repeat_font_color": {
      "type": "color",
      "label": "customization.repeat_font_color",
      "default": "#F6C32A"
    },
    "panel_font_size": {
      "type": "font-size",
      "label": "customization.panel_size",
      "default": 14
    },
    "panel_font_color": {
      "type": "color",
      "label": "customization.panel_font_color",
      "default": "#F6C32A"
    },
    "border_spacing": {
      "type": "border-spacing",
      "label": "customization.border",
      "default": 5
    },
    "text_shadow": {
      "type": "toggle",
      "label": "customization.text_shadow",
      "default": false
    },
    "shadow_intensity": {
      "type": "range",
      "label": "customization.shadow_intensity",
      "default": 0.8,
      "min": 0.2,
      "max": 1,
      "step": 0.05,
      "percent": true
    },
    "shadow_blur": {
      "type": "range",
      "label": "customization.shadow_blur",
      "default": 2.2,
      "min": 0.5,
      "max": 5,
      "step": 0.1
    },
    "text_box": {
      "type": "toggle",
      "label": "customization.text_box",
      "default": true
    },
    "box_opacity": {
      "type": "range",
      "label": "customization.box_opacity",
      "default": 0.75,
      "min": 0.1,
      "max": 0.9,
      "step": 0.05,
      "percent": true
    },
    "box_border": {
      "type": "toggle",
      "label": "customization.box_border",
      "default": false
    },
    "box_border_color": {
      "type": "color",
      "label": "customization.box_border_color",
      "default": "#FFFFFF"
    }
  }
}
