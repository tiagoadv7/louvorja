# Copie este arquivo para ".env" na raiz do projeto (já coberto pelo
# .gitignore — nunca vai pro git) e preencha com um token real.
#
# Necessário só para "npm run electron:publish" (ver scripts/publish.js).
# Gere em https://github.com/settings/tokens → "Generate new token (classic)"
# → escopo "repo".

GH_TOKEN=
